//Load base config
includeConfig 'config/base.config'

manifest {
    contributors = 'GHRU Team'
    name = 'BACTOALERT'
    homePage = 'https://github.com/cgps-discovery/GHRU-assembly'
    description = 'Bacterial genomic surveillance and offline reporting; assembly workflows adapted from GHRU Assembly.'
    mainScript = 'main.nf'
    version = '4.1.0'
    nextflowVersion = '>=24.10.3'
}

plugins {
    id 'nf-schema@2.2.0'
}

process {
    withName: 'FASTA_INPUT:PREPARE_FASTA' {
        stageInMode = 'copy'
    }
}

params { 
    run_genome_similarity = true
    run_snp_phylogeny = false
    collect_results = true
    run_id = null
    qualibact_dir = "${projectDir}/assets/qualibact_20261030T235912Z"
    report_reference_dir = null
    snp_groups = null
    snp_min_core_fraction = 0.90
    snp_recombination = true
    run_ska_snp = false
    comparison_species = null
    comparison_groups_dir = null
    snp_references = null
    ska_kmer = 31
    comparison_python_container = 'python:3.11-slim'
    mashtree_container = 'staphb/mashtree:1.4.6'
    ska2_container = 'staphb/ska2:0.5.1'
    snippy_container = 'staphb/snippy:4.6.0'
    gubbins_container = 'staphb/gubbins:3.3.5'
    iqtree3_container = 'staphb/iqtree3:3.0.1'
    snp_dists_container = 'staphb/snp-dists:0.8.2'
    input_type = 'wgs'
    input_format = 'fastq'
    samplesheet = null
    fasta_samplesheet = null
    fasta = null
    rrna16s_samplesheet = null
    rrna16s_fasta = null
    rrna16s_db = "${projectDir}/databases/ncbi_16s"
    rrna16s_min_identity = 97.0
    rrna16s_min_coverage = 90.0
    rrna16s_min_length = 200
    rrna16s_max_ambiguous = 0.01
    rrna16s_score_window = 1.0
    rrna16s_max_hits = 100
    outdir = "${launchDir}/output"
    adapter_file = "${projectDir}/data/adapters.fas"
    max_memory = '16.GB'
    max_cpus = 8
    max_time = '10.h'
    min_contig_length = 500
    medaka_model = 'r941_e81_fast_g514'
    run_speccheck = true
}

validation {
    help {
        enabled = true
        beforeText = "(( ! ))  BACTOALERT | Bacterial genomic surveillance"
        command = 'nextflow run main.nf --samplesheet <samplesheet> --outdir <output_dir> --run_id <run_id>'
    }
    summary {
        enabled = true
    }
}

profiles {
    standard {
        docker.runOptions='-u $(id -u):$(id -g)'
        docker.enabled = true

        process {
            executor = 'local'
            container = 'varunshamanna/bash_ghru'
            withLabel: bash_container {
                container = 'varunshamanna/bash_ghru'
            }
            withLabel: python_container {
                container = 'python'
            }
            withLabel: lrge_container{
                container = 'quay.io/biocontainers/lrge:0.1.3--h9f13da3_1'
            }
            withLabel: trimmomatic_container{
                container = 'quay.io/biocontainers/trimmomatic:0.36--3'
            }
            withLabel: fastqc_container{
                container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
            }
            withLabel: shovill_container{
                container = 'staphb/shovill:1.1.0-2022Dec'
            }
            withLabel: quast_container{
                container = 'quay.io/biocontainers/quast:5.2.0--py312pl5321hc60241a_4'
            }
            withLabel: dragonflye_container{
                container =  'varunshamanna/dragonflye_medaka'
            }
            withLabel: 'nanoplot_container'{
                container = 'quay.io/biocontainers/nanoplot:1.42.0--pyhdfd78af_0'
            }
            withLabel: 'porechop_container'{
                container = 'quay.io/biocontainers/porechop:0.2.4--py310h84f13bb_8'
            }
            withLabel: 'unicycler_container'{
                container = 'quay.io/biocontainers/unicycler:0.5.0--py39heaaa4ec_5'
            }
            withLabel: 'checkm_container'{
                container = 'happykhan/checkm2:0.1.0'
            }
            withLabel: 'speciation_container'{
                container = 'juliofdiaz/speciator:4.0.0'
            }
            withLabel: 'speccheck_container' {
                container = 'happykhan/speccheck:1.3.0'
            }
            withLabel: 'sylph_container' {
                container = 'happykhan/sylph:0.1.0'
            }
            withLabel: 'ariba_container' {
                container = 'happykhan/ariba_contam:0.1.1'
            }            
            withLabel: amrfinder_container {
                container = 'ncbi/amr:4.2.7-2026-08-07.1'
            }
            withLabel: mlst_container {
                container = 'staphb/mlst:latest'
            }
            withLabel: virulence_container {
                container = 'staphb/virulencefinder:latest'
            }
            withLabel: plasmidfinder_container {
                container = 'staphb/plasmidfinder:latest'
            }
           withLabel: kleborate_container {
                container = 'staphb/kleborate:3.2.4-micromamba'
            }
           withLabel: python_container  {
                container = 'python:3.11-slim'
            }
           withLabel: blast_container {
                container =  'staphb/blast:latest'
            }  
        }
    }
    bmrc {
        apptainer {
            enabled = true
            runOptions = '--bind /well --bind /gpfs3 --bind /well/aanensen/shared/nextflow_workflows/amrfinder-review/temp:/amrfinder/temp  --no-home'
        }
        process {
            cpus = 1
            memory = '2G'
            executor = 'slurm'
            queue = 'short,long'
            clusterOptions='-A aanensen.prj'
            penv = 'shmem'
            errorStrategy = { task.attempt <= 5 ? "retry" : "finish" }
            maxRetries = 5
            container = '/well/aanensen/shared/singularity/nf-amrfinder-test/python-base_latest.sif'
            withName: CLEMONTTYPING {
                container = '/well/aanensen/shared/singularity/clermont-test/clermontyping_clermontyping-1.0.0-nextflow.sif'
            }

        }
        tower {
            enabled = false
        }
    }
}
